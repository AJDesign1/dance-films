# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the browser

# Subdomain theming
NEXT_PUBLIC_ROOT_DOMAIN=dancefilms.co.uk

# Stripe (Stage 6)
STRIPE_SECRET_KEY=                  # server only
STRIPE_WEBHOOK_SECRET=              # server only
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Bunny Stream (video host) — the library ID shown in the Bunny dashboard for
# the video library holding these shows. Not secret (it appears in the public
# embed URL anyway), so no separate API key is needed for streaming.
BUNNY_LIBRARY_ID=
